# Database & auth secrets (use random URL-safe alphanumeric strings)
LOCAL_DB_PASSWORD=
SAMSAKU_DEV_TOKEN=

# Production VPS domain for Caddy automatic HTTPS (leave blank or :80 for HTTP/IP only)
# SAMSAKU_DOMAIN=keuangan.domainanda.com

# Optional Supabase Auth / Private File Storage (leave empty for self-hosted token mode)
# OWNER_ID=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# FILE_STORAGE_BUCKET=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional connector tokens (leave unset until the corresponding client is paired)
BCA_TOKEN=
GOPAY_TOKEN=
TELEGRAM_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USER_ID=

# Gemini Vision AI key for receipt scanning (required for /v1/receipts/scan; local Tesseract removed for low-RAM VPS)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
